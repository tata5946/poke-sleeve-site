{
   "background": {
      "service_worker": "LspWaoMeBackground.js"
   },
   "content_scripts": [ {
      "js": [ "LspWaoMeDom.js" ],
      "match_about_blank": true,
      "matches": [ "http://*/*", "https://*/*" ],
      "run_at": "document_end"
   }, {
      "js": [ "LspWaoMeGoogleDrive.js" ],
      "matches": [ "https://drive.google.com/*" ],
      "run_at": "document_end"
   } ],
   "description": "WebAccessLog Engine (ME)",
   "host_permissions": [ "http://*/*", "https://*/*" ],
   "icons": {
      "128": "LspWaoicon128.png",
      "16": "LspWaoicon16.png",
      "48": "LspWaoicon48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "LspMeExtension",
   "permissions": [ "tabs", "downloads", "nativeMessaging", "webRequest", "alarms", "storage" ],
   "update_url": "https://edge.microsoft.com/extensionwebstorebase/v1/crx",
   "version": "1.1.0.0"
}
